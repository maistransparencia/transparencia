# ==============================================================================
# TRANSPARÊNCIA - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para .env.local (em apps/web) ou .env (na raiz) e preencha
# com os valores adequados para o seu ambiente de desenvolvimento.
# Todas as variáveis são validadas em tempo de compilação e execução via t3-env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AMBIENTE DA APLICAÇÃO (Next.js)
# ------------------------------------------------------------------------------
NODE_ENV=development
# SKIP_ENV_VALIDATION=false

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (PostgreSQL / Kysely)
# ------------------------------------------------------------------------------
# URL de leitura/geral do PostgreSQL local (Docker: localhost:5544)
DATABASE_URL=postgresql://postgres:postgres@localhost:5544/postgres
# URL de escrita (opcional, fallback automático para DATABASE_URL)
# DATABASE_WRITE_URL=postgresql://postgres:postgres@localhost:5544/postgres
# Tamanho máximo do pool de conexões (padrão: 5)
DATABASE_POOL_MAX=5

# ------------------------------------------------------------------------------
# 3. NEWSLETTER E E-MAILS TRANSACIONAIS (Resend)
# ------------------------------------------------------------------------------
# Chave de API do Resend (opcional em desenvolvimento local)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuv
# Remetente dos e-mails transacionais e boletins cívicos
RESEND_FROM_EMAIL="MaisTransparencia <info@maistransparencia.org>"

# ------------------------------------------------------------------------------
# 4. AUTOMAÇÕES E SEGURANÇA DE CRON (Rotas Protegidas e Endpoints Internos)
# ------------------------------------------------------------------------------
# Token secreto para rotas de Cron disparadas por Vercel Cron ou automações externas
CRON_SECRET=super-secret-cron-token-min-1-char
# Token de proteção para endpoints de API interna
INTERNAL_API_SECRET=internal-api-secret-token
# Token específico para despacho do boletim periódico cívico (Radar)
DIGEST_SECRET=digest-secret-token
# Token específico para publicação e agendamento de posts sociais
SOCIAL_SECRET=social-secret-token

# ------------------------------------------------------------------------------
# 5. REDES SOCIAIS E BOTS (X.com / Twitter & Meta / Facebook)
# ------------------------------------------------------------------------------
# Credenciais do Bot do X.com (@mtransparenciax) - API v2 (OAuth 1.0a User Context)
X_API_KEY=x-consumer-api-key
X_API_SECRET=x-consumer-api-secret
X_ACCESS_TOKEN=x-access-token
X_ACCESS_TOKEN_SECRET=x-access-token-secret
X_BEARER_TOKEN=x-bearer-token

# Credenciais da Página do Facebook - Graph API v22.0
FACEBOOK_PAGE_ID=123456789012345
FACEBOOK_PAGE_ACCESS_TOKEN=EAA...facebook_page_access_token

# ------------------------------------------------------------------------------
# 6. HOSPEDAGEM E DEPLOY (Vercel)
# ------------------------------------------------------------------------------
# Injetado automaticamente pela Vercel em ambientes de deploy/preview (opcional em dev local)
# VERCEL_URL=transparencia-web-preview.vercel.app

# ------------------------------------------------------------------------------
# 7. INFORMAÇÕES INSTITUCIONAIS E DOMÍNIO PÚBLICO (Prefixo NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# URL canônica base da aplicação web (ex: http://localhost:3001 em dev ou https://maistransparencia.com em prod)
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Domínio público exibido nos cards OpenGraph e rodapés
NEXT_PUBLIC_SITE_DOMAIN=maistransparencia.com
# Nome do site institucional
NEXT_PUBLIC_SITE_NAME=MaisTransparencia
# Nome amigável do projeto cívico
NEXT_PUBLIC_PROJECT_NAME=MaisTransparencia
# Links e identificadores das redes sociais oficiais
NEXT_PUBLIC_X_URL=https://x.com/<username>
NEXT_PUBLIC_X_HANDLE=@<username>
NEXT_PUBLIC_GITHUB_URL=https://github.com/<username>/<repo>
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/<username>

# ------------------------------------------------------------------------------
# 8. TELEMETRIA E ANALYTICS (PostHog)
# ------------------------------------------------------------------------------
# Token de projeto do PostHog (opcional; desativa telemetria se ausente)
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Host do ingestão de eventos do PostHog (padrão: https://us.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com