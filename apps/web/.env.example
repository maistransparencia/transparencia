# PostgreSQL / Supabase Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5544/postgres
PORTAL_SLUG=porciuncula_prefeitura

# Supabase Auth & Database Client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Assistente Fiscal AI & Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Trava de Segurança e Guard-Rails
AI_ANONYMOUS_DAILY_LIMIT=5
SUPERADMIN_SECRET_KEY=your-superadmin-secret-key-for-dev-bypass

# PostHog Telemetria e Analytics
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
